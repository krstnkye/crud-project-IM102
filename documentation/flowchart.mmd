flowchart TD
    A([Start]) --> B["Open the app (run main.py)"]
    B --> C["Load inventory.db (make the tables if missing)"]
    C --> SI["Sign in, or create an account<br/>(password is saved only as a salted hash)"]
    SI --> V{"Details valid and<br/>password correct?"}
    V -->|No| VE["Show red error message<br/>(pause after 5 wrong tries)"]
    VE --> SI
    V -->|Yes| D["Main screen: product table, summary cards,<br/>and saved activity log"]
    D --> E{Choose an action}
    E -->|Add| F[Type the product details]
    E -->|Update| G[Click a product and change details]
    E -->|Delete| X[Click a product]
    E -->|Sign out| SO(["Back to Sign In"])
    E -->|Exit| Z([End])
    F --> I{Is the input valid?}
    G --> I
    I -->|No| J[Show red error message in form]
    I -->|Yes| K["Save the change to inventory.db<br/>and record who did it"]
    X --> Q{Confirm delete?}
    Q -->|Yes| K
    Q -->|No| R2(["Back to main screen"])
    K --> N["Refresh the table and cards,<br/>show success message"]
    J --> R1(["Back to main screen"])
    N --> R3(["Back to main screen"])
